generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DeliveryType {
  INDOOR
  OUTDOOR
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courierTransactions CourierTransaction[]

  @@map("users")
}

model Venue {
  id           String   @id @default(cuid())
  name         String
  indoorPrice  Decimal  @db.Decimal(10, 2)
  outdoorPrice Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  carriedBalance       Decimal   @default(0) @db.Decimal(10, 2)
  prevCarriedBalance   Decimal?  @default(0) @db.Decimal(10, 2)
  lastSettledAt        DateTime?
  lastSettledAmount    Decimal?  @db.Decimal(10, 2)
  totalCollectedAmount Decimal   @default(0) @db.Decimal(10, 2)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  courierVenuePrices CourierVenuePrice[]
  deliveryRecords    DeliveryRecord[]

  @@index([name])
  @@index([isActive])
  @@map("venues")
}

model Courier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  indoorPrice  Decimal  @default(0) @db.Decimal(10, 2)
  outdoorPrice Decimal  @default(0) @db.Decimal(10, 2)
  paidAmount   Decimal  @default(0) @db.Decimal(10, 2)
  carriedBalance Decimal @default(0) @db.Decimal(10, 2)
  lastSettledAt  DateTime?
  lastSettledAmount Decimal @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courierVenuePrices CourierVenuePrice[]
  deliveryRecords    DeliveryRecord[]
  transactions       CourierTransaction[]
  advances           CourierAdvance[]
  settlementPeriods  SettlementPeriod[]

  @@index([name])
  @@index([isActive])
  @@map("couriers")
}

model CourierVenuePrice {
  id           String   @id @default(cuid())
  courierId    String
  venueId      String
  indoorPrice  Decimal  @db.Decimal(10, 2)
  outdoorPrice Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([courierId, venueId])
  @@index([courierId])
  @@index([venueId])
  @@map("courier_venue_prices")
}

model DeliveryRecord {
  id                   String       @id @default(cuid())
  date                 DateTime     @db.Date
  courierId            String?
  venueId              String?
  deliveryType         DeliveryType
  packageCount         Int          @default(0)
  venuePriceSnapshot   Decimal      @default(0) @db.Decimal(10, 2)
  venueTotalAmount     Decimal      @default(0) @db.Decimal(10, 2)
  courierPriceSnapshot Decimal      @default(0) @db.Decimal(10, 2)
  courierTotalAmount   Decimal      @default(0) @db.Decimal(10, 2)
  unitPriceSnapshot    Decimal      @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal      @default(0) @db.Decimal(10, 2)
  isSettled            Boolean      @default(false)
  settledAt            DateTime?
  isCourierSettled     Boolean      @default(false)
  courierSettledAt     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  courier Courier? @relation(fields: [courierId], references: [id], onDelete: Cascade)
  venue   Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([courierId])
  @@index([venueId])
  @@index([venueId, isSettled])
  @@index([courierId, isCourierSettled])
  @@index([courierId, date])
  @@index([venueId, date])
  @@index([date, deliveryType])
  @@map("delivery_records")
}

model CourierTransaction {
  id           String   @id @default(uuid())
  courierId    String
  amount       Decimal  @db.Decimal(10, 2)
  entryDate    DateTime @db.Date @map("entry_date")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  createdById  String?  @map("created_by")

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([courierId])
  @@index([entryDate])
  @@index([courierId, entryDate])
  @@map("courier_transactions")
}

model CourierAdvance {
  id          String    @id @default(uuid())
  courierId   String    @map("courier_id")
  amount      Decimal   @db.Decimal(10, 2)
  date        DateTime  @db.Date
  time        String?
  week        String?
  periodId    String?   @map("period_id")
  description String?
  status      String    @default("ACTIVE")
  closedAt    DateTime? @map("closed_at")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  courier Courier           @relation(fields: [courierId], references: [id], onDelete: Cascade)
  period  SettlementPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([courierId])
  @@index([date])
  @@index([week])
  @@index([status])
  @@index([periodId])
  @@index([courierId, date])
  @@index([courierId, status])
  @@map("courier_advances")
}

model SettlementPeriod {
  id               String    @id @default(uuid())
  type             String    @default("WEEKLY")
  courierId        String?   @map("courier_id")
  week             String?
  startDate        DateTime  @db.Date @map("start_date")
  endDate          DateTime  @db.Date @map("end_date")
  totalPackages    Int       @default(0) @map("total_packages")
  totalEarnings    Decimal   @default(0) @db.Decimal(10, 2) @map("total_earnings")
  totalAdvance     Decimal   @default(0) @db.Decimal(10, 2) @map("total_advance")
  paidAmount       Decimal   @default(0) @db.Decimal(10, 2) @map("paid_amount")
  remainingBalance Decimal   @default(0) @db.Decimal(10, 2) @map("remaining_balance")
  closedAt         DateTime  @default(now()) @map("closed_at")
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  courier  Courier?         @relation(fields: [courierId], references: [id], onDelete: Cascade)
  advances CourierAdvance[]

  @@index([courierId])
  @@index([week])
  @@index([startDate, endDate])
  @@map("settlement_periods")
}

